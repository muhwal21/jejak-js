{
  "name": "jejak-js",
  "version": "0.1.0",
  "description": "Open-source JavaScript playground with inline values, live comments, coverage, Value Explorer and a Time Machine debugger.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build:single": "node scripts/build-single.mjs"
  },
  "keywords": [
    "javascript",
    "playground",
    "repl",
    "debugger",
    "time-travel",
    "live-coding",
    "education"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/codemirror": "^5.60.15",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "codemirror": "^5.65.18",
    "lz-string": "^1.5.0"
  },
  "private": true,
  "type": "module"
}
