{
  "name": "jejak-js",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source JavaScript playground with inline values, live comments, coverage, Value Explorer and a Time Machine debugger.",
  "keywords": [
    "javascript",
    "playground",
    "repl",
    "debugger",
    "time-travel",
    "live-coding",
    "education"
  ],
  "homepage": "https://muhwal21.github.io/jejak-js/",
  "bugs": {
    "url": "https://github.com/muhwal21/jejak-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhwal21/jejak-js.git"
  },
  "license": "MIT",
  "author": "Awal (https://github.com/muhwal21)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
